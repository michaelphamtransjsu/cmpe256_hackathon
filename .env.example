# Read these into your process using your shell/secret manager; this file is not auto-executed.
SPECIALIST_DATA_DIR=./data
# hash + extractive runs Clinical/Corporate locally; OpenAI specialist mode is opt-in.
# The Manager always needs OpenAI for routing/synthesis, even with extractive specialists.
# Technology/SEC retain their prepared MiniLM/TF-IDF caches and need local model weights.
SPECIALIST_EMBEDDINGS_PROVIDER=hash
SPECIALIST_LLM_PROVIDER=extractive
SPECIALIST_CHAT_MODEL=gpt-4.1-mini
SPECIALIST_EMBEDDING_MODEL=text-embedding-3-small
SPECIALIST_TOP_K=5
SPECIALIST_MIN_SCORE=0.08
# For OpenAI mode, set OPENAI_API_KEY securely in the environment.
